{
  "name": "@hr-app/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "dotenv -e ../../.env -e ../../.env.example -- prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate dev --schema prisma/schema.prisma",
    "db:reset:local": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate reset --force --schema prisma/schema.prisma",
    "db:rebuild:local": "corepack pnpm db:generate && corepack pnpm db:reset:local",
    "db:deploy": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env -e ../../.env.example -- prisma studio --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -e ../../.env.example -- tsx prisma/seed.ts",
    "audit:geo-timezone": "dotenv -e ../../.env -e ../../.env.example -- tsx prisma/audit-geo-timezone-data.ts",
    "auth:seed:dev": "dotenv -e ../../.env -e ../../.env.example -- tsx scripts/seed-supabase-auth-users.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test test"
  },
  "dependencies": {
    "@hr-app/geo": "workspace:^",
    "@hr-app/timezones": "workspace:^",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
