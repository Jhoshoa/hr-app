{
  "name": "hr-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "corepack pnpm --filter @hr-app/database db:generate",
    "db:migrate": "corepack pnpm --filter @hr-app/database db:migrate",
    "db:seed": "corepack pnpm --filter @hr-app/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
